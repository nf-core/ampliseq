/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Purpose: check that --consolidate_taxonomies most-specific picks a winner per ASV across
    classifiers (DADA2 with two databases, SINTAX and VSEARCH-LCA).

    Use as follows:
        nextflow run nf-core/ampliseq -profile test_consolidate_tools,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name = 'Test profile for taxonomy consolidation across classifiers'
    config_profile_description = 'Minimal test dataset to check --consolidate_taxonomies most-specific with DADA2, SINTAX and VSEARCH-LCA'

    // Input data
    primer_fwd = "CTTGGTCATTTAGAGGAAGTAA"
    primer_rev = "TCCTGAGGGAAACTTCG"
    input = params.pipelines_testdata_base_path + "ampliseq/samplesheets/Samplesheet_pacbio_ITS_v3.tsv"
    metadata = params.pipelines_testdata_base_path + "ampliseq/samplesheets/Metadata_pacbio_ITS.tsv"
    sequencing_type = "pacbio"
    sample_inference = "independent"
    max_ee = 12
    cut_its = "its2"

    dada_ref_taxonomy = "unite-fungi=8.2,unite-fungi=8.3"
    sintax_ref_taxonomy = "unite-fungi=8.2"
    vsearch_lca_ref_taxonomy = "unite-fungi=8.2"
    consolidate_taxonomies = "most-specific"

    // strict cutoffs so that both DADA2 and SINTAX win some ASVs
    dada_min_boot = 90
    sintax_cutoff = 0.9

    //this is to remove low abundance ASVs to reduce runtime of downstream processes
    min_samples = 2
    min_frequency = 10

    skip_fastqc = true
    skip_alpha_rarefaction = true
    skip_diversity_indices = true
}
