/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/ampliseq Nextflow config file for the Diat.barcode test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Purpose: classify rbcL sequences against a small Diat.barcode subset hosted in
    nf-core/test-datasets instead of the full database.

    Use as follows:
        nextflow run nf-core/ampliseq -profile test_diatbarcode,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name = 'Test profile for Diat.barcode database'
    config_profile_description = 'Minimal test dataset to verify pipeline function with the Diat.barcode reference database'

    input_fasta = params.pipelines_testdata_base_path + "ampliseq/testdata/diat_barcode_ASV_seqs.fasta"
    dada_ref_taxonomy = "diat-barcode"
    skip_barrnap = true
    skip_qiime = true

    dada_ref_databases.'diat-barcode' = [
        title:"Diat.barcode - rbcL (263 bp) reference library for diatoms - test subset",
        file:[
            params.pipelines_testdata_base_path + "ampliseq/testdata/diat_barcode_v15_2_tax_assign_dada2_subset.fa"
        ],
        citation:"Rimet F, et al. Diat.barcode, an open-access curated barcode library for diatoms. Sci Rep. 2019;9:15116. doi: 10.1038/s41598-019-51500-6",
        fmtscript:"taxref_reformat_diatbarcode.sh",
        dbversion:"Diat.barcode 15_2 test subset",
        taxlevels:"Domain,Kingdom,Phylum,Class,Order,Family,Genus,Species"
    ]
}
