/*
========================================================================================
    Nextflow config file for running ITSxRust tests
========================================================================================
    Inherits test_pacbio_its and overrides ITS extractor to use ITSxRust.

    Use as follows:
        nextflow run nf-core/ampliseq -profile test_itsxrust,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test_pacbio_its.config'

params {
    config_profile_name        = 'ITSxRust test profile'
    config_profile_description = 'Test ITS extraction with ITSxRust using PacBio ITS test data'
    its_extractor              = 'itsxrust'
}