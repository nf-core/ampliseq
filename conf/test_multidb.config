/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Purpose: check that a comma-separated `--dada_ref_taxonomy` (multiple databases) works, without
    the extra opt-in features `test.config` carries (a second classifier, vsearch clustering,
    decontam, ANCOM/ANCOMBC/ANCOMBC2) that aren't needed to cover this feature.

    Use as follows:
        nextflow run nf-core/ampliseq -profile test_multidb,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name = 'Test profile for multi-database DADA2 taxonomy'
    config_profile_description = 'Minimal test dataset to check pipeline function with a comma-separated --dada_ref_taxonomy'

    // Input data
    primer_fwd = "GTGYCAGCMGCCGCGGTAA"
    primer_rev = "GGACTACNVGGGTWTCTAAT"
    input = params.pipelines_testdata_base_path + "ampliseq/samplesheets/Samplesheet_v3.tsv"
    metadata = params.pipelines_testdata_base_path + "ampliseq/samplesheets/Metadata.tsv"

    // two databases, both already used elsewhere in this repo's test suite
    dada_ref_taxonomy = "gtdb=R07-RS207,rdp=18"
    cut_dada_ref_taxonomy = true

    // ASV generation
    sample_inference = "independent"

    //this is to remove low abundance ASVs to reduce runtime of downstream processes, and to make sure
    //QIIME2_TABLEFILTERTAXA (a real consumer of ch_tax) actually runs
    min_frequency = 10
}
