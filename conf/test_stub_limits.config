/*
========================================================================================
    Nextflow config for stub runs (`-stub-run`) of the pipeline test profiles
========================================================================================
    Layered on top of a regular test profile by the stub tests in `tests/`:

        options "-stub -c conf/test_stub_limits.config"

    `resourceLimits` is a config directive, not a param, so it cannot be set from the
    `params {}` block of a `.nf.test` file. `min_read_counts = 0` is required because
    stub FASTQ producers emit zero reads and the pipeline gates on read counts.

    `ref_taxonomy_storage` is set by each stub test instead: it must point inside that
    test's own `outdir`, which only the `.nf.test` file knows. Pointing it at the shared
    `ref_taxonomy_storage/` cache would be unsafe, because `DOWNLOAD_REFERENCE` uses
    `storeDir` and Nextflow reuses any file already found there.
========================================================================================
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '5.GB',
        time: '2.h'
    ]
}

executor {
    cpus = 2
    memory = '5.GB'
}

params {
    min_read_counts = 0
}
