/*
========================================================================================
    Nextflow config file for running minimal tests
========================================================================================
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/ampliseq -profile test_vsearch_lca,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name = 'Test VSEARCH LCA profile'
    config_profile_description = 'Minimal test dataset to check pipeline function when using built-in VSEARCH LCA taxonomy assignment'

    // Input data
    input_fasta = params.pipelines_testdata_base_path + "ampliseq/testdata/ASV_seqs.fasta"

    // Built-in VSEARCH LCA taxonomy
    vsearch_lca_ref_taxonomy = "coidb=221216"

    // keep runtime lower by disabling other taxonomy/classifier workflows
    skip_dada_taxonomy = true
    skip_qiime = true
}
