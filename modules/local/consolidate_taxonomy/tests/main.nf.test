nextflow_process {

    name "Test Process CONSOLIDATE_TAXONOMY"
    script "../main.nf"
    process "CONSOLIDATE_TAXONOMY"
    tag "modules"
    tag "modules_local"
    tag "consolidate_taxonomy"

    test("a database with Domain and Kingdom keeps its own Kingdom") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dbA": "ASV_ID|Kingdom|Phylum|confidence|kingdom_confidence|phylum_confidence|sequence;asv1|Bacteria||0.9|0.9||ACGT;",
                    "dbB": "ASV_ID|Domain|Kingdom|Phylum|confidence|domain_confidence|kingdom_confidence|phylum_confidence|sequence;asv1|Eukaryota|Fungi|Ascomycota|0.8|1|0.9|0.8|ACGT;"
                ]
                def files = "dbA,dbB".split(",").collect { key ->
                    def text = tables[key]
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = text.replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "most-specific"
                input[2] = "DADA2:dbA,DADA2:dbB"
                input[3] = "Kingdom,Phylum"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            assertAll(
                { assert process.success },
                { assert header.count("Kingdom") == 1 },
                { assert asv1[header.indexOf("Kingdom")] == "Fungi" },
                { assert asv1[header.indexOf("database")] == "dbB" }
            )
        }
    }

    test("a rank holding only F is kept as text") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dbA": "ASV_ID|Kingdom|Family|confidence|kingdom_confidence|family_confidence|sequence;asv1|Bacteria|F|1|1|1|ACGT;",
                    "dbB": "ASV_ID|Kingdom|Family|confidence|kingdom_confidence|family_confidence|sequence;asv1|Bacteria||0.9|0.9||ACGT;"
                ]
                def files = "dbA,dbB".split(",").collect { key ->
                    def text = tables[key]
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = text.replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "score"
                input[2] = "DADA2:dbA,DADA2:dbB"
                input[3] = "Kingdom,Family"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            assertAll(
                { assert process.success },
                { assert asv1[header.indexOf("Family")] == "F" },
                { assert asv1[header.indexOf("database")] == "dbA" }
            )
        }
    }

    test("BOLD_bin does not count as a rank") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dbA": "ASV_ID|Kingdom|Phylum|BOLD_bin|confidence|kingdom_confidence|phylum_confidence|sequence;asv1|Animalia||BOLD:1|0.9|0.9||ACGT;",
                    "dbB": "ASV_ID|Kingdom|Phylum|BOLD_bin|confidence|kingdom_confidence|phylum_confidence|sequence;asv1|Animalia|Chordata||0.8|0.9|0.8|ACGT;"
                ]
                def files = "dbA,dbB".split(",").collect { key ->
                    def text = tables[key]
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = text.replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "most-specific"
                input[2] = "DADA2:dbA,DADA2:dbB"
                input[3] = "Kingdom,Phylum,BOLD_bin"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            assertAll(
                { assert process.success },
                { assert asv1[header.indexOf("database")] == "dbB" }
            )
        }
    }

    test("score: a genus assignment more confident at family wins over a family assignment") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dbA": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|kingdom_confidence|phylum_confidence|family_confidence|genus_confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Bacillus|0.6|1|1|0.99|0.6|ACGT;",
                    "dbB": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|kingdom_confidence|phylum_confidence|family_confidence|genus_confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae||0.9|1|1|0.9|0.3|ACGT;"
                ]
                def files = "dbB,dbA".split(",").collect { key ->
                    def text = tables[key]
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = text.replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "score"
                input[2] = "DADA2:dbB,DADA2:dbA"
                input[3] = "Kingdom,Phylum,Family,Genus"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            assertAll(
                { assert process.success },
                { assert asv1[header.indexOf("Genus")] == "Bacillus" },
                { assert asv1[header.indexOf("database")] == "dbA" }
            )
        }
    }

    test("score: a family assignment more confident at family wins over a genus assignment") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dbA": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|kingdom_confidence|phylum_confidence|family_confidence|genus_confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Bacillus|0.6|1|1|0.95|0.6|ACGT;",
                    "dbB": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|kingdom_confidence|phylum_confidence|family_confidence|genus_confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae||0.99|1|1|0.99|0.3|ACGT;"
                ]
                def files = "dbA,dbB".split(",").collect { key ->
                    def text = tables[key]
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = text.replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "score"
                input[2] = "DADA2:dbA,DADA2:dbB"
                input[3] = "Kingdom,Phylum,Family,Genus"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            assertAll(
                { assert process.success },
                { assert asv1[header.indexOf("database")] == "dbB" }
            )
        }
    }

    test("score: databases tied at a shared rank are compared again at their next shared rank") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dbA": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|kingdom_confidence|phylum_confidence|family_confidence|genus_confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Bacillus|0.6|1|1|1|0.6|ACGT;",
                    "dbB": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|kingdom_confidence|phylum_confidence|family_confidence|genus_confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Priestia|0.95|1|1|1|0.95|ACGT;",
                    "dbC": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|kingdom_confidence|phylum_confidence|family_confidence|genus_confidence|sequence;asv1|Bacteria|Bacillota|||0.8|1|0.8|0.4|0.2|ACGT;"
                ]
                def files = "dbA,dbB,dbC".split(",").collect { key ->
                    def text = tables[key]
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = text.replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "score"
                input[2] = "DADA2:dbA,DADA2:dbB,DADA2:dbC"
                input[3] = "Kingdom,Phylum,Family,Genus"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            assertAll(
                { assert process.success },
                { assert asv1[header.indexOf("Genus")] == "Priestia" },
                { assert asv1[header.indexOf("database")] == "dbB" }
            )
        }
    }

    test("score: a deeper rank without bootstrap breaks a tie") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dbA": "ASV_ID|Kingdom|Genus|Species|confidence|kingdom_confidence|genus_confidence|sequence;asv1|Bacteria|Bacillus|subtilis|1|1|1|ACGT;",
                    "dbB": "ASV_ID|Kingdom|Genus|confidence|kingdom_confidence|genus_confidence|sequence;asv1|Bacteria|Bacillus|1|1|1|ACGT;"
                ]
                def files = "dbB,dbA".split(",").collect { key ->
                    def text = tables[key]
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = text.replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "score"
                input[2] = "DADA2:dbB,DADA2:dbA"
                input[3] = "Kingdom,Genus,Species"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            assertAll(
                { assert process.success },
                { assert asv1[header.indexOf("Species")] == "subtilis" },
                { assert asv1[header.indexOf("database")] == "dbA" }
            )
        }
    }

    test("most-specific: the table with the deepest rank wins per ASV, whichever classifier made it") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dada2": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|kingdom_confidence|phylum_confidence|family_confidence|genus_confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae||0.9|1|1|0.9|0.3|ACGT;asv2|Bacteria|Bacillota|Bacillaceae|Bacillus|0.8|1|1|1|0.8|TTTT;",
                    "sintax": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Bacillus|0.7|ACGT;asv2|Bacteria|Bacillota|||0.9|TTTT;"
                ]
                def files = ["dada2", "sintax"].collect { key ->
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = tables[key].replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "most-specific"
                input[2] = "DADA2:silva,SINTAX:silva"
                input[3] = "Kingdom,Phylum,Family,Genus"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            def asv2 = rows.find { it[0] == "asv2" }
            assertAll(
                { assert process.success },
                { assert asv1[header.indexOf("Genus")] == "Bacillus" },
                { assert asv1[header.indexOf("classifier")] == "SINTAX" },
                { assert asv1[header.indexOf("database")] == "silva" },
                { assert asv2[header.indexOf("Genus")] == "Bacillus" },
                { assert asv2[header.indexOf("classifier")] == "DADA2" }
            )
        }
    }

    test("most-specific: a tie goes to the first listed source") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dada2": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Bacillus|1|ACGT;",
                    "sintax": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Bacillus|1|ACGT;",
                    "vsearch": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Bacillus|1|ACGT;"
                ]
                def files = ["dada2", "sintax", "vsearch"].collect { key ->
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = tables[key].replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "most-specific"
                input[2] = "DADA2:silva,SINTAX:coidb,VSEARCH-LCA:coidb"
                input[3] = "Kingdom,Phylum,Family,Genus"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            def asv2 = rows.find { it[0] == "asv2" }
            assertAll(
                { assert process.success },
                { assert asv1[header.indexOf("classifier")] == "DADA2" }
            )
        }
    }

    test("most-specific: a tie follows the order of the sources, not the classifier names") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dada2": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Bacillus|1|ACGT;",
                    "sintax": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Bacillus|1|ACGT;",
                    "vsearch": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|Bacillus|1|ACGT;"
                ]
                def files = ["vsearch", "sintax", "dada2"].collect { key ->
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = tables[key].replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "most-specific"
                input[2] = "VSEARCH-LCA:coidb,SINTAX:coidb,DADA2:silva"
                input[3] = "Kingdom,Phylum,Family,Genus"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            def asv2 = rows.find { it[0] == "asv2" }
            assertAll(
                { assert process.success },
                { assert asv1[header.indexOf("classifier")] == "VSEARCH-LCA" },
                { assert asv1[header.indexOf("database")] == "coidb" }
            )
        }
    }

    test("most-specific: confidence is blank when tables from different classifiers are mixed") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dada2": "ASV_ID|Kingdom|Phylum|Family|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|90|ACGT;asv2|Bacteria|Bacillota||80|TTTT;",
                    "sintax": "ASV_ID|Kingdom|Phylum|Family|confidence|sequence;asv1|Bacteria|Bacillota||0.9|ACGT;asv2|Bacteria|Bacillota|Bacillaceae|0.9|TTTT;"
                ]
                def files = ["dada2", "sintax"].collect { key ->
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = tables[key].replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "most-specific"
                input[2] = "DADA2:silva,SINTAX:coidb"
                input[3] = "Kingdom,Phylum,Family"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            assertAll(
                { assert process.success },
                // each classifier won one ASV, so the column would otherwise mix a 0-100 bootstrap with a 0-1 probability
                { assert rows.find { it[0] == "asv1" }[header.indexOf("classifier")] == "DADA2" },
                { assert rows.find { it[0] == "asv2" }[header.indexOf("classifier")] == "SINTAX" },
                { assert rows.drop(1).every { it[header.indexOf("confidence")] == "" } }
            )
        }
    }

    test("most-specific: confidence is kept when all tables come from DADA2") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dada2a": "ASV_ID|Kingdom|Phylum|Family|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|90|ACGT;",
                    "dada2b": "ASV_ID|Kingdom|Phylum|Family|confidence|sequence;asv1|Bacteria|Bacillota||80|ACGT;"
                ]
                def files = ["dada2a", "dada2b"].collect { key ->
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = tables[key].replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "most-specific"
                input[2] = "DADA2:silva,DADA2:rdp"
                input[3] = "Kingdom,Phylum,Family"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            assertAll(
                { assert process.success },
                { assert rows.find { it[0] == "asv1" }[header.indexOf("confidence")] == "90" }
            )
        }
    }

    test("most-specific: a table without any of the target ranks stops the process") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dada2": "ASV_ID|Kingdom|Phylum|Class|confidence|sequence;asv1|Bacteria|Bacillota|Bacilli|90|ACGT;",
                    "sintax": "ASV_ID|K|P|C|O|confidence|sequence;asv1|Bacteria|Bacillota|Bacilli|Bacillales|0.9|ACGT;"
                ]
                def files = ["dada2", "sintax"].collect { key ->
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = tables[key].replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "most-specific"
                input[2] = "DADA2:silva,SINTAX:custom"
                input[3] = "Kingdom,Phylum,Class"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                // the message names the offending source, so the user can fix its taxonomic levels
                { assert process.errorReport.contains("SINTAX:custom") }
            )
        }
    }

    test("most-specific: an ASV nobody classified has no classifier or database") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dada2": "ASV_ID|Kingdom|Phylum|Family|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae|90|ACGT;asv2|||||TTTT;",
                    "sintax": "ASV_ID|Kingdom|Phylum|Family|confidence|sequence;asv1|Bacteria|Bacillota||0.9|ACGT;asv2|||||TTTT;"
                ]
                def files = ["dada2", "sintax"].collect { key ->
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = tables[key].replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "most-specific"
                input[2] = "DADA2:silva,SINTAX:coidb"
                input[3] = "Kingdom,Phylum,Family"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            def asv1 = rows.find { it[0] == "asv1" }
            def asv2 = rows.find { it[0] == "asv2" }
            assertAll(
                { assert process.success },
                { assert asv1[header.indexOf("classifier")] == "DADA2" },
                { assert asv1[header.indexOf("database")] == "silva" },
                // the first source would win the tie, but it classified nothing
                { assert asv2[header.indexOf("classifier")] == "" },
                { assert asv2[header.indexOf("database")] == "" }
            )
        }
    }

    test("most-specific: ranks filled are counted, so a gap does not make a table deeper") {

        when {
            process {
                """
                def dir = File.createTempDir()
                def tables = [
                    "dada2": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|sequence;asv1|Bacteria|Bacillota|Bacillaceae||90|ACGT;",
                    "sintax": "ASV_ID|Kingdom|Phylum|Family|Genus|confidence|sequence;asv1|Bacteria|Bacillota||Bacillus|0.9|ACGT;"
                ]
                def files = ["dada2", "sintax"].collect { key ->
                    def f = new File(dir, "tax_\${key}.tsv")
                    f.text = tables[key].replace("|", "\\t").replace(";", "\\n")
                    file(f.absolutePath)
                }
                input[0] = files
                input[1] = "most-specific"
                input[2] = "DADA2:silva,SINTAX:coidb"
                input[3] = "Kingdom,Phylum,Family,Genus"
                input[4] = "consolidated.tsv"
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0]).readLines().collect { it.split("\t", -1) as List }
            def header = rows[0]
            assertAll(
                { assert process.success },
                // both fill three ranks, SINTAX reaches Genus past its gap, and the first source still wins
                { assert rows.find { it[0] == "asv1" }[header.indexOf("classifier")] == "DADA2" }
            )
        }
    }
}
