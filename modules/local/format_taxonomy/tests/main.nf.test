nextflow_process {

    name "Test Process FORMAT_TAXONOMY"
    script "../main.nf"
    process "FORMAT_TAXONOMY"
    tag "modules"
    tag "modules_local"
    tag "format_taxonomy"

    test("MIDORI2: the CO1 file is taken from the zip holding every gene and formatted for DADA2") {

        when {
            process {
                """
                def zip = new File(File.createTempDir(), "MIDORI2_GB273_DADA2_sp.zip")
                new java.util.zip.ZipOutputStream(zip.newOutputStream()).withCloseable { z ->
                    [
                        "DADA2_sp/uniq/MIDORI2_UNIQ_NUC_SP_GB273_Cytb_DADA2.fasta.gz": ">cytb\\nAAAA\\n",
                        "DADA2_sp/uniq/MIDORI2_UNIQ_NUC_SP_GB273_CO1_DADA2.fasta.gz": [
                            ">phylum_class_order_family_genus_Amoebozoa sp._1892891;class_order_family_genus_Amoebozoa sp._1892891;order_family_genus_Amoebozoa sp._1892891;family_genus_Amoebozoa sp._1892891;genus_Amoebozoa sp._1892891;Amoebozoa sp._1892891;",
                            "CGATTGAC",
                            ">phylum_Chordata_7711;class_Mammalia_40674;order_Primates_9443;family_Hominidae_9604;genus_Homo_9605;Homo sapiens_9606;",
                            "TTGGCCAA",
                            ""
                        ].join("\\n")
                    ].each { name, content ->
                        z.putNextEntry(new java.util.zip.ZipEntry(name))
                        def bytes = new ByteArrayOutputStream()
                        new java.util.zip.GZIPOutputStream(bytes).withCloseable { it << content.bytes }
                        z.write(bytes.toByteArray())
                        z.closeEntry()
                    }
                }
                input[0] = ["midori2-co1", file(zip.absolutePath)]
                """
            }
        }

        then {
            def assign = process.success ? path(process.out.assigntax[0][1]).readLines() : []
            def species = process.success ? path(process.out.addspecies[0][1]).readLines() : []
            assertAll(
                { assert process.success },
                // rank prefixes and taxon ids are removed; only CO1 records are present, not the Cytb decoy
                { assert assign == [
                    ">Amoebozoa sp.;Amoebozoa sp.;Amoebozoa sp.;Amoebozoa sp.;Amoebozoa sp.;Amoebozoa sp.;", "CGATTGAC",
                    ">Chordata;Mammalia;Primates;Hominidae;Homo;Homo sapiens;", "TTGGCCAA"
                ] },
                // the species and its NCBI taxon id become the fake sequence id for addSpecies()
                { assert species == [">1892891 Amoebozoa sp.", "CGATTGAC", ">9606 Homo sapiens", "TTGGCCAA"] }
            )
        }
    }
}
