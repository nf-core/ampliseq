nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    profile "test_savont"

    test("-profile test_savont") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path and file name
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])

            // specific files
            def savont_asv_logs = getAllFilesFromDir(params.outdir, include: ['savont/*_savont.log'])
            def savont_export_logs = getAllFilesFromDir(params.outdir, include: ['savont/*_savont_export.log'])
            def performance_summary = getAllFilesFromDir(params.outdir, include: ['comparison/performance_summary.tsv'])
            def profile_summary = getAllFilesFromDir(params.outdir, include: ['comparison/profile_summary.tsv'])

            // Exact sample names from the input sheet must be preserved in the output tables.
            def input_samples = path("$outputDir/input/Samplesheet_nanopore_v3.tsv").text.readLines().drop(1).findAll { it.trim() }.collect { it.tokenize('\t')[0] }
            def asv_samples = path("$outputDir/savont/pooled_feature-table.tsv").text.readLines()[0].tokenize('\t')
            def summary_samples = path("$outputDir/overall_summary.tsv").text.readLines().drop(1).findAll { it.trim() }.collect { it.tokenize('\t')[0] }
            def reltax_headers = getAllFilesFromDir(params.outdir, include: ['qiime2/rel_abundance_tables/rel-table-ASV_*-tax.tsv']).collect { it.text.readLines()[0].tokenize('\t') }
            def cutadapt_samples = path("$outputDir/cutadapt/cutadapt_summary.tsv").text.readLines()[0].tokenize('\t')
            def lengthfilter_samples = path("$outputDir/asv_length_filter/ASV_table.len.tsv").text.readLines()[0].tokenize('\t')

            assert workflow.success
            assertAll(
                { assert snapshot(
                    // Number of tasks that completed successfully
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_ampliseq_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // Manually chosen files for md5sum checks
                    path("$outputDir/savont/pooled_feature-table.tsv"),
                    path("$outputDir/savont/pooled_final_asvs.fasta"),
                    path("$outputDir/savont/pooled_stats.tsv"),
                    path("$outputDir/overall_summary.tsv"),
                    path("$outputDir/comparison/nucleotide-differences.log"),
                    path("$outputDir/comparison/nucleotide-differences.tsv"),
                    path("$outputDir/comparison/performance.log"),
                    path("$outputDir/comparison/profile.log"),
                ).match() },

                { assert snapshot(
                    "savont_asv_logs contains 'SAVONT COMPLETED SUCCESSFULLY': ${savont_asv_logs.every { log -> log.readLines().any { it.contains('SAVONT COMPLETED SUCCESSFULLY') } }}",
                    "savont_export_logs contains 'Export complete.': ${savont_export_logs.every { log -> log.readLines().any { it.contains('Export complete.') } }}",
                ).match("log-checks") },

                // Check median F1 scores, assumes that the median value is next after the F1 value
                { assert snapshot(
                    "performance_summary.tsv: median F1 > 0.8: ${performance_summary.every { log -> log.readLines().find { it.startsWith('F1\t') }.split('\t')[1].toFloat() > 0.8 } }",
                    "profile_summary.tsv: median F1 at level 6 > 0.8: ${profile_summary.every { log -> log.readLines().find { it.startsWith('L6\tF1\t') }.split('\t')[2].toFloat() > 0.8 }}",
                ).match("comparison-checks") },

                // Exact sample names from the input sheet must be preserved.
                { assert asv_samples.containsAll(input_samples) },
                { assert summary_samples.containsAll(input_samples) },
                { assert reltax_headers.size() > 0 },
                { assert reltax_headers.every { header -> header.containsAll(input_samples) } },
                { assert cutadapt_samples.containsAll(input_samples) },
                { assert lengthfilter_samples.containsAll(input_samples) }
            )
        }
    }
}
